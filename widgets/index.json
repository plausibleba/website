          "url": "https://plausibleba.com/widgets/operating_posture_card/v1.0/"
        }
      ]
    },
    {
      "widgetId": "regulatory_anchors_strip",
      "description": "Horizontal pill strip listing charter.regulatoryAnchors[] \u2014 one pill per anchor showing regulator badge + reference text. Field names confirmed: 'regulator' + 'reference' (not framework/name/versionPin \u2014 those don't exist on regulatoryAnchors[]). Pure-charter read.",
      "sourcePrimitives": [
        "charter.regulatoryAnchors"
      ],
      "latest": "v1.0",
      "status": "published",
